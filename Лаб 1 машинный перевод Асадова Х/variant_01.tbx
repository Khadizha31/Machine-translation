      <termEntry id="tid-002">
        <descrip type="subjectField">Информационные технологии: разработка ПО и DevOps</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>continuous integration</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The practice of merging all branches to a shared mainline several times a day.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>технология непрерывной интеграции</term>
