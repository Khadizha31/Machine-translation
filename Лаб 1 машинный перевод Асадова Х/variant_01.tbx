        <langSet xml:lang="en">
          <tig>
            <term>analyst</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Someone whose job is to study or examine something in detail, in order to discover or understand more about it and often to make predictions relating to it.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>аналитик</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
