        <descrip type="subjectField">Информационные технологии: разработка ПО и DevOps</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>configuration management</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The process by which all artifacts relevant to your project, and the relationships between them, are stored, retrieved, uniquely identified, and modified.</descrip>
